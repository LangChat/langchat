# ==============================================================================
# LangChat 一体化部署环境变量样例
#
# 使用方式：
#   cp .env.example .env
#   按需修改后执行 docker compose up -d
# ==============================================================================

# ------------------------------ 应用 ------------------------------
# 对外暴露的 HTTP 端口（浏览器访问 http://<host>:<端口>）
LANGCHAT_HTTP_PORT=80
LANGCHAT_IMAGE_NAME=langchat
LANGCHAT_IMAGE_TAG=latest

# 后端 YAML，使用相对于 docker-compose.yml 所在目录的路径，或填写绝对路径。
LANGCHAT_CONFIG_SOURCE=./application-docker.yml

# JVM 参数：容器内存较小时请下调 -Xmx
LANGCHAT_JAVA_OPTS=-Xms512m -Xmx1024m -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai

# ------------------------------ MySQL ------------------------------
MYSQL_DATABASE=langchat
MYSQL_PASSWORD=123456
# 宿主机映射端口（默认仅绑定 127.0.0.1，避免数据库暴露公网）
MYSQL_PORT=127.0.0.1:3306

# ----------------------------- PGVector ----------------------------
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=postgres
PGVECTOR_DATABASE=langchat
PGVECTOR_PORT=127.0.0.1:5432

# ------------------------------ RustFS -----------------------------
# 必须与 application-docker.yml 中的 S3 access-key / secret-key 保持一致。
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=change-me
RUSTFS_API_PORT=127.0.0.1:9000
RUSTFS_CONSOLE_PORT=127.0.0.1:9001
