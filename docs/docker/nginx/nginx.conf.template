# ==============================================================================
# 独立 Nginx 反向代理配置（模板文件）
#
# 本文件通过官方 nginx 镜像的模板机制生效：
#   compose 将其挂载为 /etc/nginx/templates/default.conf.template，
#   容器启动时由入口脚本用 envsubst 把 ${LANGCHAT_UPSTREAM} 替换为实际上游地址。
#
# 注意：Nginx 不会自动替换普通 .conf 中的 ${VAR}，必须走 templates 目录，
#       否则上游地址会变成字面量导致启动失败。
#
# 可调项：
#   - 上游地址：修改 compose 中的 LANGCHAT_UPSTREAM
#   - 域名与证书：放开文件末尾的 HTTPS 段并修改 server_name
# ==============================================================================

# WebSocket 升级判断：有 Upgrade 头则透传，否则按短连接关闭
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    # 启用 HTTPS 后，放开下一行让 HTTP 自动跳转
    # return 301 https://$host$request_uri;

    client_max_body_size 500m;
    server_tokens off;

    location / {
        # ${LANGCHAT_UPSTREAM} 由 envsubst 注入（形如 172.17.0.1:80）
        proxy_pass http://${LANGCHAT_UPSTREAM};
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 支持 WebSocket 升级
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # AI 对话为 SSE 流式响应，关闭缓冲并放宽超时
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}

